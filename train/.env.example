# ============================================================
# IRON MILES TRAINING — environment
#
# With none of this set the app runs in DEMO MODE: a seeded
# in-memory dataset behind the same data interface, so the whole
# product is explorable without provisioning anything.
#
# Setting the two NEXT_PUBLIC_SUPABASE_ values switches every read
# and write to Postgres under row-level security. Nothing else in
# the application changes.
# ============================================================

# ---------- Supabase (auth + database + storage) ----------
# Project settings → API. The anon key is designed to be public and
# is useless without the RLS policies in supabase/migrations/0002_rls.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Server-only: used by the Stripe webhook, the cron jobs
# and account deletion. Never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe (subscriptions) ----------
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the dashboard endpoint in production.
STRIPE_WEBHOOK_SECRET=
# One price id per coaching package. The package definition in
# src/data/packages.ts names which env var it reads.
STRIPE_PRICE_EVENT_READY=

# ---------- Email (Resend) ----------
# The one external notification channel. Without RESEND_API_KEY, email is
# reported as unavailable in production and simulated in demo mode — it is
# never silently skipped.
#
# SETUP, IN ORDER:
#   1. Create a Resend account at https://resend.com. Register it with
#      ironmilesclub@outlook.com — that address then becomes the only one
#      Resend's built-in test sender is allowed to deliver to, which is
#      exactly what the test-send flow needs.
#   2. API Keys → Create. Paste it below as RESEND_API_KEY. That alone is
#      enough to prove real delivery to ironmilesclub@outlook.com.
#   3. To email actual coaches, Resend requires a domain you control:
#      Domains → Add ironmiles.ie, publish the DNS records it gives you
#      (SPF, DKIM, and a return-path CNAME), wait for Verified, then set
#      EMAIL_FROM_ADDRESS and EMAIL_FROM_VERIFIED=true.
#
# NOTE ON ironmilesclub@outlook.com: no transactional provider will send as
# an address on a domain you cannot add DNS records to, and nobody can add
# them to outlook.com. So it is used as Reply-To, not From — a coach hitting
# reply still reaches the real Iron Miles mailbox.
RESEND_API_KEY=

# Until a domain is verified, leave this blank: mail goes out as Resend's
# onboarding@resend.dev, which only delivers to the Resend account's own
# address. Once ironmiles.ie is verified, something like training@ironmiles.ie.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Iron Miles Training
# Set to true ONLY once the domain shows Verified in Resend. Nothing else
# claims the sender is verified, and a wrong value here means rejected mail.
EMAIL_FROM_VERIFIED=

# Where a coach's reply goes. Needs no provider verification.
EMAIL_REPLY_TO=ironmilesclub@outlook.com

# Resend → Webhooks. Without it /api/webhooks/resend refuses every request
# rather than trusting unsigned claims about delivery, and deliveries stop
# honestly at "sent" instead of ever reaching "delivered".
RESEND_WEBHOOK_SECRET=

# The only address POST /api/admin/email-test will ever send to. There is no
# `to` parameter, so the test flow cannot be pointed at a coach or a list.
EMAIL_TEST_RECIPIENT=ironmilesclub@outlook.com

# ---------- Scheduled jobs ----------
# Required for /api/cron/* and /api/admin/email-test to run at all. Without
# it those endpoints refuse every request rather than defaulting open.
#
# SCHEDULE (Vercel Cron, or any scheduler that can send a bearer token):
#   */15 * * * *   /api/cron/coach-alerts
#   0    * * * *   /api/cron/coach-digest           (hourly; each coach's own
#                                                    local hour is respected
#                                                    inside the job)
#   */5  * * * *   /api/cron/notification-delivery
#
# All three are idempotent and restart-safe: re-running one sends nothing
# twice. The digest runs hourly rather than daily on purpose — a coach in
# Sydney and a coach in Limerick have different mornings.
CRON_SECRET=

# ---------- Deployment ----------
# Absolute origin, used for Stripe redirects and auth callbacks.
# Falls back to VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://train.ironmiles.ie
