# ============================================================
# IRON MILES TRAINING — environment
#
# With none of this set the app runs in DEMO MODE: a seeded
# in-memory dataset behind the same data interface, so the whole
# product is explorable without provisioning anything.
#
# Setting the two NEXT_PUBLIC_SUPABASE_ values switches every read
# and write to Postgres under row-level security. Nothing else in
# the application changes.
# ============================================================

# ---------- Supabase (auth + database + storage) ----------
# Project settings → API. The anon key is designed to be public and
# is useless without the RLS policies in supabase/migrations/0002_rls.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Server-only: used by the Stripe webhook, the cron jobs
# and account deletion. Never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe (subscriptions) ----------
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the dashboard endpoint in production.
STRIPE_WEBHOOK_SECRET=
# One price id per coaching package. The package definition in
# src/data/packages.ts names which env var it reads.
STRIPE_PRICE_EVENT_READY=

# ---------- Scheduled jobs ----------
# Required for /api/cron/* to run at all. Without it the endpoint
# refuses every request rather than defaulting open.
CRON_SECRET=

# ---------- Deployment ----------
# Absolute origin, used for Stripe redirects and auth callbacks.
# Falls back to VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://train.ironmiles.ie
