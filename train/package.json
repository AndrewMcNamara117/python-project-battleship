    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "motion": "^12.23.24",
    "next": "16.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.64.0",
    "recharts": "^3.2.1",
    "stripe": "^19.1.0",
    "three": "^0.181.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.181.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.3.3",
