{
  "name": "iron-miles-training",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/alias-hooks-register.mjs --test \"src/**/*.test.ts\" \"supabase/test/*.test.mjs\"",
    "test:libraries": "node --test supabase/test/libraries.test.mjs",
    "test:rls": "node --test supabase/test/rls.test.mjs",
    "test:e2e": "node e2e/loop.mjs",
    "test:guards": "node e2e/guards.mjs",
    "test:duplication": "node e2e/duplication.mjs",
    "test:library": "node e2e/library.mjs",
    "test:programme": "node e2e/programme.mjs",
    "test:extraction": "node e2e/extraction.mjs",
    "test:adaptation": "node e2e/adaptation.mjs",
    "_comment:e2e": "Demo state lives in the server process, so order matters. loop drives the athlete-coach loop from a clean seed and must run first; adaptation needs the athlete's current week still intact, so it runs before the suites that churn it.",
    "test:e2e:all": "node e2e/loop.mjs && node e2e/adaptation.mjs && node e2e/guards.mjs && node e2e/duplication.mjs && node e2e/library.mjs && node e2e/programme.mjs && node e2e/extraction.mjs"
  },
  "dependencies": {
